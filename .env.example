# Copy to .env and fill in values from the Supabase project dashboard.
# Project Settings → API

# Public project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# anon / public key (safe for browser clients with RLS)
SUPABASE_ANON_KEY=

# service_role key (server only — never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: JWT secret used to verify Supabase auth tokens
SUPABASE_JWT_SECRET=

# Optional: direct Postgres connection (Project Settings → Database)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: transaction pooler (recommended for serverless / many short connections)
DATABASE_POOLER_URL=

# Storage bucket created by supabase/schema.sql
SUPABASE_STORAGE_BUCKET=akshar-documents

# --- Akshar studio (existing) ---
AKSHAR_HOST=127.0.0.1
AKSHAR_PORT=8765
